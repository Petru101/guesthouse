diff --git a/hw/misc/nvfwd/runs.c b/hw/misc/nvfwd/runs.c
new file mode 100644
index 0000000..46b325a
--- /dev/null
+++ b/hw/misc/nvfwd/runs.c
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* See runs.h. */
+#include "runs.h"
+
+#include <stddef.h>
+
+static bool page_aligned(uint64_t value)
+{
+    return !(value & (RUNS_PAGE_BYTES - 1));
+}
+
+bool runs_check(const struct nvfwd_runs *runs, uint64_t room, uint64_t limit, uint64_t needed,
+                uint64_t *total)
+{
+    uint64_t sum = 0;
+    uint32_t count, i;
+
+    if (room < sizeof(*runs)) {
+        return false;
+    }
+    count = runs->count;
+    if (!count || count > RUNS_MAX_COUNT ||
+        (uint64_t)count * sizeof(runs->run[0]) > room - sizeof(*runs)) {
+        return false;
+    }
+    for (i = 0; i < count; i++) {
+        uint64_t gpa = runs->run[i].gpa, len = runs->run[i].len, last;
+
+        /* The sum is held to `limit` at each step, so it can never wrap. */
+        if (!len || !page_aligned(gpa) || !page_aligned(len) || len > limit - sum ||
+            __builtin_add_overflow(gpa, len - 1, &last)) {
+            return false;
+        }
+        sum += len;
+    }
+    if (!needed || runs->first_offset >= sum || needed > sum - runs->first_offset) {
+        return false;
+    }
+    *total = sum;
+    return true;
+}
diff --git a/hw/misc/nvfwd/runs.h b/hw/misc/nvfwd/runs.h
new file mode 100644
index 0000000..4c85607
--- /dev/null
+++ b/hw/misc/nvfwd/runs.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Run lists: the guest pages behind one pinned buffer, which the device maps side by side so the
+ * host driver sees a single range. A list comes from the guest, so nothing in it is believed
+ * until runs_check() has passed it.
+ */
+#ifndef NVFWD_RUNS_H
+#define NVFWD_RUNS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "nvfwd_proto.h"
+
+/* One mapping each, so this bounds the time a single call can spend here. */
+#define RUNS_MAX_COUNT (1u << 17)
+#define RUNS_PAGE_BYTES 4096u
+
+/*
+ * True if the list at `runs`, in `room` bytes of the call, is whole pages of guest memory adding up
+ * to no more than `limit`, and the `needed` bytes the host driver will touch, from first_offset on,
+ * lie inside it. Sets *total to the bytes to map.
+ */
+bool runs_check(const struct nvfwd_runs *runs, uint64_t room, uint64_t limit, uint64_t needed,
+                uint64_t *total);
+
+#endif
