From 9ef2d718c6b114df5df85ab09553f58dfa44374c Mon Sep 17 00:00:00 2001
From: xnixy <x@ruxn.com>
Date: Thu, 5 Nov 2026 12:13:11 -0800
Subject: [PATCH 05/21] hw/hyperv: keep reading a GPU-PV channel until a pass
 finds nothing

A guest signals only when it finds the ring empty, so a packet written after
recv_start read write_index, and before recv_done moved read_index, brings no
signal. Asynchronous messages, which get no reply, hit this within seconds.
---
 hw/hyperv/gpupv.c | 31 ++++++++++++++++++++++---------
 1 file changed, 22 insertions(+), 9 deletions(-)

diff --git a/hw/hyperv/gpupv.c b/hw/hyperv/gpupv.c
index f0b0f3a..6a3bfbd 100644
--- a/hw/hyperv/gpupv.c
+++ b/hw/hyperv/gpupv.c
@@ -169,18 +169,31 @@ static void gpupv_chan_notify(VMBusChannel *chan)
 {
     GpupvChannel *s = GPUPV_CHANNEL(vmbus_channel_device(chan));
     VMBusChanReq *req;
+    bool got_packet;
 
     gpupv_flush(s);
 
-    if (vmbus_channel_recv_start(chan)) {
-        return;
-    }
-    while ((req = vmbus_channel_recv_peek(chan, sizeof(*req)))) {
-        gpupv_forward(s, req);
-        vmbus_free_req(req);
-        vmbus_channel_recv_pop(chan);
-    }
-    vmbus_channel_recv_done(chan);
+    /*
+     * The guest signals only when it finds the ring empty. A packet it writes
+     * after recv_start has read write_index, but before recv_done has moved
+     * read_index, finds it not empty, so no signal comes for it, and nothing
+     * else would make us look. So read until a whole pass finds nothing.
+     * Traffic where each packet waits for its reply rarely hits this. Packets
+     * that nobody replies to, such as asynchronous messages, hit it in seconds.
+     */
+    do {
+        got_packet = false;
+        if (vmbus_channel_recv_start(chan)) {
+            return;
+        }
+        while ((req = vmbus_channel_recv_peek(chan, sizeof(*req)))) {
+            gpupv_forward(s, req);
+            vmbus_free_req(req);
+            vmbus_channel_recv_pop(chan);
+            got_packet = true;
+        }
+        vmbus_channel_recv_done(chan);
+    } while (got_packet);
 }
 
 static void gpupv_drop_arena(GpupvChannel *s)
-- 
