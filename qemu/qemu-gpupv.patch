new file mode 100644
index 0000000..3687d71
--- /dev/null
+++ b/hw/misc/nvfwd/rmargs.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Which parts of a forwarded call the host's driver will treat as a pointer or a file. A guest
+ * only says where it would like these patched; this file says where they are, from the call alone.
+ * Any field the guest left alone is cleared rather than passed on, so a value of the guest's can
+ * never reach the driver as a host address or a host file.
+ */
+#ifndef NVFWD_RMARGS_H
+#define NVFWD_RMARGS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "nvfwd_proto.h"
+#include "rm_layout.h"
+
+#define RMARGS_MAX_FIELDS (NVFWD_MAX_FIX + 16u)
+
+typedef struct RmField {
+    uint32_t at;   /* in the call's data */
+    uint32_t kind; /* NVFWD_FIX_* */
+    uint32_t size; /* for a pointer, bytes the driver may touch behind it */
+} RmField;
+
+typedef struct RmCall {
+    uint32_t nr;      /* the escape, after any transfer header */
+    uint32_t cmd;     /* the ioctl number as the guest gave it */
+    uint32_t arg_at;  /* where the arguments start in the data */
+    uint32_t size;    /* their length */
+    const uint8_t *data;
+    uint32_t len;     /* bytes of data in this call */
+    const struct nvfwd_fix *fix;
+    uint32_t nfix;
+} RmCall;
+
+/*
+ * Reads what the guest sent into a call: which escape, where its arguments are, and how long. On
+ * false, the request cannot be what it says it is.
+ */
+bool rmargs_parse(RmCall *call, uint32_t cmd, const uint8_t *data, uint32_t len,
+                  const struct nvfwd_fix *fix, uint32_t nfix);
+
+/*
+ * Lists the fields of a call, and matches the fixes against them. Fills `fields` and returns how
+ * many, or a negative errno if a fix is aimed at anything else or a size does not fit the call.
+ * Each field's `fix` index is in `matched`, or -1 where the guest offered none.
+ */
+int rmargs_fields(const RmCall *call, RmField *fields, int *matched);
+
+/* The same for UVM, where the only such field is one optional fd at a place given by the call. */
+int rmargs_uvm_fields(uint32_t cmd, uint32_t len, const struct nvfwd_fix *fix, uint32_t nfix,
+                      RmField *fields, int *matched);
+
+#endif
