--- a/hw/i386/acpi-build.c
+++ b/hw/i386/acpi-build.c
@@ -472,6 +472,24 @@ static Aml *build_vmbus_device_aml(VMBusBridge *vmbus_bridge)
     aml_append(crs, aml_irq_no_flags(vmbus_bridge->irq));
     aml_append(dev, aml_name_decl("_CRS", crs));
 
+    if (vmbus_bridge->mmio_size) {
+        Aml *vmod = aml_device("VMOD");
+
+        aml_append(vmod, aml_name_decl("_HID", aml_string("ACPI0004")));
+        aml_append(vmod, aml_name_decl("_UID", aml_int(0x0)));
+        crs = aml_resource_template();
+        aml_append(crs, aml_qword_memory(AML_POS_DECODE, AML_MIN_FIXED,
