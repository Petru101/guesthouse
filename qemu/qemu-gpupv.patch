new file mode 100644
index 0000000..ff1ffdb
--- /dev/null
+++ b/hw/misc/nvfwd/callrate.c
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* See callrate.h. */
+#include "callrate.h"
+
+#include <stdbool.h>
+
+#define NS_PER_SECOND 1000000000ull
+
+void callrate_init(CallRate *r, uint32_t calls_per_second, uint32_t burst_calls)
+{
+    r->call_ns = calls_per_second ? NS_PER_SECOND / calls_per_second : 0;
+    r->burst_ns = r->call_ns * burst_calls;
+    r->next_ns = 0;
+}
+
+uint64_t callrate_wait_ns(CallRate *r, uint64_t now_ns)
+{
+    uint64_t next = __atomic_load_n(&r->next_ns, __ATOMIC_RELAXED), after;
+
+    if (!r->call_ns) {
+        return 0;
+    }
+    /* Lockless because vCPUs call this at once, and a lost race only means trying again. */
+    do {
+        after = (next > now_ns ? next : now_ns) + r->call_ns;
+    } while (!__atomic_compare_exchange_n(&r->next_ns, &next, after, true, __ATOMIC_RELAXED,
+                                          __ATOMIC_RELAXED));
+    return after > now_ns + r->burst_ns ? after - now_ns - r->burst_ns : 0;
+}
diff --git a/hw/misc/nvfwd/callrate.h b/hw/misc/nvfwd/callrate.h
new file mode 100644
index 0000000..3446779
--- /dev/null
+++ b/hw/misc/nvfwd/callrate.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * A limit on calls a second for one VM, with a burst on top: starting a program makes thousands of
+ * calls at once and then goes quiet, and that must not be slowed. Time is passed in, so the logic
+ * can be tested without a clock.
+ */
+#ifndef NVFWD_CALLRATE_H
+#define NVFWD_CALLRATE_H
+
+#include <stdint.h>
+
+typedef struct CallRate {
+    uint64_t call_ns;  /* one call's share of a second; 0 means no limit */
+    uint64_t burst_ns; /* how far ahead of the rate calls may run */
+    uint64_t next_ns;  /* when the rate would allow the next call */
+} CallRate;
+
+void callrate_init(CallRate *r, uint32_t calls_per_second, uint32_t burst_calls);
+
+/* Counts a call made at `now_ns`, and says how long it has to wait. Safe from any thread. */
+uint64_t callrate_wait_ns(CallRate *r, uint64_t now_ns);
+
+#endif
diff --git a/hw/misc/nvfwd/meson.build b/hw/misc/nvfwd/meson.build
new file mode 100644
index 0000000..1c13d58
--- /dev/null
+++ b/hw/misc/nvfwd/meson.build
@@ -0,0 +1,5 @@
