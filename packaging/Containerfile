# Where the app and its helpers are built. They call so little of glibc that they run on far older
# ones than this. GTK is what the build needs to be recent, and its programs load the host's anyway.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install gcc git xz findutils which binutils pkgconf-pkg-config rust cargo gtk4-devel \
      libadwaita-devel \
    && dnf clean all
