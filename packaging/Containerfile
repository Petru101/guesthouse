# Where a release is built. A program built here runs on this glibc or a newer one, so this stays the
# oldest system that can run the app at all. libadwaita 1.8 is the app's floor today, and Fedora 44 has
# it, with glibc 2.43, the same as Ubuntu 26.04.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install gcc gcc-c++ make ninja-build meson python3 git bzip2 diffutils findutils which xz \
      glib2-devel pixman-devel zlib-devel libfdt-devel libslirp-devel pipewire-devel libusb1-devel \
      rust cargo gtk4-devel libadwaita-devel binutils \
    && dnf clean all
