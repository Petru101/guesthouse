# What a desktop on the GPU needs: Zink on NVIDIA's Vulkan driver, on the real nvidia-drm. Lines of
# KEY=value, which a shell can source and systemd's environment.d reads as they are.
# NVIDIA's Vulkan driver needs NVIDIA's EGL vendor loaded, and Mesa must come first to win.
__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json:/usr/share/glvnd/egl_vendor.d/10_nvidia.json
GBM_BACKEND=dri
GALLIUM_DRIVER=zink
MESA_LOADER_DRIVER_OVERRIDE=zink
VK_DRIVER_FILES=/usr/share/vulkan/icd.d/nvidia_icd.x86_64.json
# The stand-in has no cursor plane, so the pointer is drawn into the frame.
MUTTER_DEBUG_DISABLE_HW_CURSORS=1
# Zink crashes compiling some shaders on its VK_EXT_shader_object path.
ZINK_DEBUG=noshobj
